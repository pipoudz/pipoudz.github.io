# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical production URL of the portal.
APP_URL="https://pipoudz.github.io"

# NEXT_PUBLIC_BASE_PATH: Leave empty when hosting at root (pipoudz.github.io or custom domain).
NEXT_PUBLIC_BASE_PATH=""
